// api.at — 真实人与人聊天 API。
// CHAT-001 profile 冻结于 docs/plans/evidence/001/capability-decision.md：
// 单共享后端 + 双独立客户端（token 请求体携带、服务器侧 sender 归属、SQLite 持久化）。
// 端点体一律 `return db.FN(args)` 薄委托（codegen resolve_db_call 契约，Plan 399 §8）。
//
// CHAT-002（T-03，决策稿 D:/autostack/plan-artifacts/plan-002/standalone-decision.md §4）：
// 移除 /api/stream 与全部 SSE 广播——生成器为单全局总线（auto-web api_gen.rs
// generate_events_rs：OnceLock<broadcast::Sender>，POST 载荷全员投递，无法按连接
// 鉴权/定向），实测匿名与第三身份均可收到私聊正文（C-03 反例已存证）。has_sse=false
// 后不生成广播；送达统一走已鉴权按会话轮询（Vue 1s RefreshTick 兜底即主通道，
// VM 轨原为轮询）。Typing/NewLoginAck 外观信号随之移除（capability-decision 已记外观性）。

pub type Identity = {
    id: str
    name: str
    avatar: str
    online: bool
}

/// POST /api/register 应答（CHAT-002）：secret 为一次性展示的 256-bit
/// 恢复凭据（仅随本响应交付给注册者，不入任何日志/列表）。
pub type RegisterResult = {
    ok: bool
    err: str
    id: str
    name: str
    avatar: str
    secret: str
    token: str
}

/// POST /api/login 应答（CHAT-002）：name + secret 恢复；token 仅随本响应交付。
pub type LoginResult = {
    ok: bool
    err: str
    id: str
    name: str
    avatar: str
    token: str
}

/// POST /api/legacy/adopt 应答（CHAT-002）：受控旧身份恢复，一次性铸发新凭据。
pub type AdoptResult = {
    ok: bool
    err: str
    secret: str
}

/// 侧栏会话摘要（沿用 Contact 界面形状；id = conversation_id，name/avatar = 对端）。
pub type Contact = {
    id: str
    name: str
    avatar: str
    status: str
    peer_id: str
    last_message: str
    time: str
    unread: int
}

pub type Conversation = {
    id: str
    peer_id: str
    peer_name: str
    peer_avatar: str
}

/// 消息。气泡方向由客户端以 sender_id == 本端 id 派生（服务器不再存 mine）；
/// time 为服务器生成的相对时间串（免时区合同，展示专用）。
pub type Message = {
    id: int
    conversation_id: str
    sender_id: str
    sender: str
    text: str
    time: str
    created_sec: int
    client_msg_id: str
}

/// 发送应答：ok=false 携带 err（unauthorized/not-a-participant/empty）。
/// 送达经已鉴权轮询（对端 1s RefreshTick 拉取）；不再有任何广播。
pub type SendResult = {
    ok: bool
    err: str
    message: Message
}

/// 客户端待确认消息（前端 pending 视图；服务器不持久化此形状）。
pub type PendingMsg = {
    client_msg_id: str
    text: str
    state: str
}

use db

/// POST /api/register — 注册新身份（CHAT-002）：服务器铸造 256-bit 恢复
/// 凭据，一次性随本响应返回；同名/legacy 名均拒绝（name-taken）。
#[api(method = "POST", path = "/api/register")]
pub fn register(name str) RegisterResult {
    return db.register(name)
}

/// POST /api/login — name + secret 恢复既有身份（CHAT-002）：服务端精确
/// 匹配校验；成功签发新会话 token（撤销旧会话）；失败一律 unauthorized。
#[api(method = "POST", path = "/api/login")]
pub fn login(name str, secret str) LoginResult {
    return db.login(name, secret)
}

/// POST /api/logout — 撤销本会话 token（服务端失效 + 客户端丢弃）。
#[api(method = "POST", path = "/api/logout")]
pub fn logout(token str) {
    return db.logout(token)
}

/// POST /api/legacy/adopt — 受控旧身份恢复（CHAT-002）：仅服务器启动 env
/// CHAT_LEGACY_ADOPT=1 时开放；旧弱 token 一次性核验，铸发新恢复凭据。
#[api(method = "POST", path = "/api/legacy/adopt")]
pub fn adopt_legacy(name str, legacy_token str) AdoptResult {
    return db.adopt_legacy(name, legacy_token)
}

/// GET /api/identities — 已注册身份公开视图（无 token），online = 15s 内有心跳。
#[api(method = "GET", path = "/api/identities")]
pub fn identities() []Identity {
    return db.identities()
}

/// POST /api/heartbeat — 刷新在线状态（void，不广播）。
#[api(method = "POST", path = "/api/heartbeat")]
pub fn heartbeat(token str) {
    return db.heartbeat(token)
}

/// GET /api/contacts?token= — 调用者视角的会话摘要（对端信息 + 最后消息 + 未读）。
#[api(method = "GET", path = "/api/contacts")]
pub fn contacts(token str) []Contact {
    return db.contacts(token)
}

/// POST /api/conversations/open — 幂等打开（或创建）与 peer 的双人会话。
#[api(method = "POST", path = "/api/conversations/open")]
pub fn open_conversation(token str, peer_id str) Conversation {
    return db.open_conversation(token, peer_id)
}

/// GET /api/messages?token=&conversation_id= — 当前会话全量历史（参与者校验）。
#[api(method = "GET", path = "/api/messages")]
pub fn list_messages(token str, conversation_id str) []Message {
    return db.list_messages(token, conversation_id)
}

/// POST /api/messages — 发送。token 解析发送者（不信任任何 sender 字段）；
/// client_msg_id 唯一约束保证重试幂等；成功即落库 + 广播 NewSendResult。
#[api(method = "POST", path = "/api/messages")]
pub fn send_message(token str, conversation_id str, text str, client_msg_id str) SendResult {
    return db.send_message(token, conversation_id, text, client_msg_id)
}

/// POST /api/typing — token 校验通过才让广播名副其实（外观性边界见
/// capability-decision.md；codegen 约束：广播 name 取首个 str 体参数）。
#[api(method = "POST", path = "/api/typing")]
pub fn set_typing(name str, token str) {
    return db.set_typing(name, token)
}

/// POST /api/read — 标记会话已读（清未读）。
#[api(method = "POST", path = "/api/read")]
pub fn mark_read(token str, conversation_id str) {
    return db.mark_read(token, conversation_id)
}

// /api/stream 已移除（CHAT-002 T-03）：单全局 SSE 总线为公开私聊旁路，
// 见本文件头注与决策稿 §4；送达统一为已鉴权按会话轮询。

/// POST /api/test/reset — 仅 CHAT_TEST_MODE=1 生效（普通模式空操作）。
#[api(method = "POST", path = "/api/test/reset")]
pub fn test_reset() {
    return db.test_reset()
}
