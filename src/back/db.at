// db.at — CHAT-001 v2 服务层（api.at 端点 ↔ 同名委托）。
//
// 层次：api.at（路由+契约类型）→ db.at（类型包装+契约构造）→
// repository.at（SQLite 协议，每函数自持连接——SqliteDb 非 Copy 不能传参，
// 见 repository.at 头注）。
// 类型结果一律先赋局部再 return（calendar T-02 探针：`return TypeName {...}`
// 直接返回不解析）。行→契约类型按下标取列，列序见 repository.at 各函数注释。
// 发送者归属只来自 token 注册表；参与者校验在 repository 读写两路径强制。
// 时间一律 epoch 秒整数（repository 内 strftime 取值），展示用相对时间串
// （服务器生成，免时区合同）。
//
// 工具链实证约束：`var on ...` 触发 scenario 解析缺陷（on 是 store 块关键
// 字，报 "expected arrow, colon or question mark"）——禁用 on 作标识符。

use api: Identity
use api: MeInfo
use api: LoginAck
use api: Contact
use api: Conversation
use api: Message
use api: SendResult

use repository

// ═══════════════════════════════════════════════════════════
// 身份与登录
// ═══════════════════════════════════════════════════════════

pub fn login(name str, nonce str) LoginAck {
    var row List<str> = repository.login_row(name, nonce)
    var ok LoginAck = LoginAck { id: row[0], name: row[1], avatar: row[2] }
    return ok
}

pub fn me(nonce str) MeInfo {
    var row List<str> = repository.identity_row_by_nonce(nonce)
    var r MeInfo = MeInfo { id: row[0], name: row[1], avatar: row[2], token: row[3] }
    return r
}

pub fn identities() []Identity {
    var out List<Identity> = List<Identity>.new([])
    var rows List<List<str>> = repository.identity_rows()
    var i int = 0
    while i < rows.len() {
        // 列序：{id, name, avatar, online("1"/"0")}
        var row List<str> = rows[i]
        var online bool = row[3] == "1"
        var it Identity = Identity { id: row[0], name: row[1], avatar: row[2], online: online }
        out.push(it)
        i = i + 1
    }
    return out
}

pub fn heartbeat(token str) {
    repository.do_heartbeat(token)
    return
}

// ═══════════════════════════════════════════════════════════
// 会话与侧栏摘要
// ═══════════════════════════════════════════════════════════

pub fn contacts(token str) []Contact {
    var out List<Contact> = List<Contact>.new([])
    var rows List<List<str>> = repository.contact_rows(token)
    var i int = 0
    while i < rows.len() {
        // 列序：{conv_id, peer_name, peer_avatar, status, peer_id, last_text, time_str, unread}
        var row List<str> = rows[i]
        var unread int = repository.parse_int(row[7])
        var c Contact = Contact { id: row[0], name: row[1], avatar: row[2], status: row[3], peer_id: row[4], last_message: row[5], time: row[6], unread: unread }
        out.push(c)
        i = i + 1
    }
    return out
}

pub fn open_conversation(token str, peer_id str) Conversation {
    var row List<str> = repository.open_conversation_row(token, peer_id)
    var c Conversation = Conversation { id: row[0], peer_id: row[1], peer_name: row[2], peer_avatar: row[3] }
    return c
}

// ═══════════════════════════════════════════════════════════
// 消息
// ═══════════════════════════════════════════════════════════

pub fn list_messages(token str, conversation_id str) []Message {
    var out List<Message> = List<Message>.new([])
    var rows List<List<str>> = repository.message_rows(token, conversation_id)
    var i int = 0
    while i < rows.len() {
        // 列序：{id, conv_id, sender_id, sender_name, text, time_str, created_sec, client_msg_id}
        var row List<str> = rows[i]
        var mid int = repository.parse_int(row[0])
        var created int = repository.parse_int(row[6])
        var m Message = Message { id: mid, conversation_id: row[1], sender_id: row[2], sender: row[3], text: row[4], time: row[5], created_sec: created, client_msg_id: row[7] }
        out.push(m)
        i = i + 1
    }
    return out
}

pub fn send_message(token str, conversation_id str, text str, client_msg_id str) SendResult {
    // 列序：{ok("1"/"0"), err, id, conv_id, sender_id, sender_name, text, time_str, created_sec, client_msg_id}
    var row List<str> = repository.send_message_row(token, conversation_id, text, client_msg_id)
    var mid int = repository.parse_int(row[2])
    var created int = repository.parse_int(row[8])
    var msg Message = Message { id: mid, conversation_id: row[3], sender_id: row[4], sender: row[5], text: row[6], time: row[7], created_sec: created, client_msg_id: row[9] }
    var ok bool = row[0] == "1"
    var r SendResult = SendResult { ok: ok, err: row[1], message: msg }
    return r
}

/// codegen 约束：void + typing 名端点总会以第一个 str 体参数广播 name；
/// 本函数只做真实身份校验（repository.check_typing）——广播的外观性边界
/// 已记入 capability-decision.md。
pub fn set_typing(name str, token str) {
    repository.check_typing(token, name)
    return
}

pub fn mark_read(token str, conversation_id str) {
    repository.do_mark_read(token, conversation_id)
    return
}

// ═══════════════════════════════════════════════════════════
// 测试隔离
// ═══════════════════════════════════════════════════════════

pub fn test_reset() {
    repository.do_reset()
    return
}
