// message_thread.at — 会话消息流：气泡方向由 sender_id == my_id 派生（服务器
// 不再存 mine）；pending 项按 state 展示发送中/失败（失败气泡点击重发）；
// 头像来自会话对端身份；typing 指示为外观性提示。
// 消息时间用服务器生成的相对时间串 msg.time（视图模板不放自由函数——
// Vue 轨模板无自由函数绑定，ReferenceError 同类缺陷）。
style avatar_box = "text-2xl p-1 bg-muted/60 rounded-xl shadow-xs flex-shrink-0 mt-0.5"
style row_gap3 = "items-center gap-3"

widget MessageThread(messages: []Message, pending: []PendingMsg, typing_name: str, peer_name: str, peer_avatar: str, peer_status: str, my_id: str, on_retry: msg) {
    msg {
        RetryTap(str)
    }

    view {
        col {
            style: "flex-1 flex-col bg-card rounded-xl shadow-sm border border-border overflow-hidden min-h-0"
            // 会话头
            row {
                style: "items-center justify-between px-6 py-3.5 border-b border-border bg-muted/20"
                row {
                    style: row_gap3
                    text .peer_avatar { style: "text-2xl p-1.5 bg-card rounded-xl shadow-xs border border-border/50" }
                    col {
                        row {
                            style: "items-center gap-2"
                            text .peer_name { style: "text-base font-bold text-foreground" }
                            if .peer_status == "online" {
                                text "🟢" { style: "text-[9px]" }
                            }
                        }
                        if .peer_status == "online" {
                            text "在线" { style: "text-xs text-muted-foreground" }
                        }
                        if .peer_status == "offline" {
                            text "离线" { style: "text-xs text-muted-foreground" }
                        }
                    }
                }
                row {
                    style: row_gap3
                    if .typing_name != "" {
                        text f"${.typing_name} 正在输入…" { style: "text-xs text-primary font-medium italic animate-pulse" }
                    }
                }
            }

            // 消息流
            col {
                style: "flex-1 overflow-y-auto p-6 gap-4"
                if .messages.len() == 0 {
                    if .pending.len() == 0 {
                        col {
                            style: "flex-1 items-center justify-center py-12"
                            text "💬" { style: "text-5xl mb-3 opacity-30" }
                            text "还没有消息" { style: "text-sm text-muted-foreground font-medium" }
                            text "在下方输入框发送第一条消息" { style: "text-xs text-muted-foreground/80 mt-1" }
                        }
                    }
                }
                for msg in .messages {
                    col {
                        if msg.sender_id == .my_id {
                            row {
                                style: "justify-end"
                                col {
                                    style: "items-end max-w-3xl"
                                    text msg.text { style: "text-sm bg-primary text-primary-foreground px-4 py-2.5 rounded-2xl rounded-tr-xs shadow-xs break-words whitespace-pre-wrap" }
                                    text msg.time { style: "text-[11px] text-muted-foreground mt-1 text-right" }
                                }
                            }
                        }
                        if msg.sender_id != .my_id {
                            row {
                                style: "justify-start gap-2.5 items-start"
                                text .peer_avatar { style: avatar_box }
                                col {
                                    style: "items-start max-w-3xl"
                                    text msg.sender { style: "text-xs font-semibold text-muted-foreground mb-1" }
                                    text msg.text { style: "text-sm bg-muted text-foreground px-4 py-2.5 rounded-2xl rounded-tl-xs shadow-xs break-words whitespace-pre-wrap" }
                                    text msg.time { style: "text-[11px] text-muted-foreground mt-1" }
                                }
                            }
                        }
                    }
                }
                for p in .pending {
                    if p.state == "failed" {
                        row {
                            style: "justify-end"
                            col {
                                style: "items-end max-w-3xl cursor-pointer"
                                onclick: .RetryTap(p.client_msg_id)
                                text p.text { style: "text-sm bg-destructive text-destructive-foreground px-4 py-2.5 rounded-2xl rounded-tr-xs break-words whitespace-pre-wrap" }
                                text "发送失败 · 点击重发" { style: "text-[11px] text-destructive mt-1 text-right" }
                            }
                        }
                    }
                    if p.state != "failed" {
                        row {
                            style: "justify-end"
                            col {
                                style: "items-end max-w-3xl opacity-60"
                                text p.text { style: "text-sm bg-primary text-primary-foreground px-4 py-2.5 rounded-2xl rounded-tr-xs break-words whitespace-pre-wrap" }
                                text "发送中…" { style: "text-[11px] text-muted-foreground mt-1 text-right" }
                            }
                        }
                    }
                }
            }
        }
    }

    on {
        .RetryTap(cid) -> {
            on_retry(cid)
        }
    }
}
