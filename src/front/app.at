// app.at — CHAT-001 v2 聊天壳：登录屏 + 双栏会话界面 + 心跳定时器。
// 1s 定时器驱动 store.RefreshTick：在线心跳、会话/身份/消息刷新（VM 轨的
// 送达通道；Vue 轨 SSE 之外的重连兜底）与 typing 过期。
use chat_store: ChatStore
use chat_sidebar: ChatSidebar
use message_thread: MessageThread
use composer: Composer

use stylekit.styles: caption_text

// PLAN-056 T-02：官方主题包主题名导入（031 合同消费面——`dep themes` 声明
// 使包可解析，本 use 把包内 pub 主题收进收集链；无此行 themes 树不注册，
// design.theme/follow 宿主候选都会在 C-11 未注册拒绝）。
use themes.themes: Auto
style main_shell = "flex-1 gap-3 min-h-0 overflow-hidden"
style login_card = "w-96 max-w-full bg-card rounded-2xl shadow-lg border border-border p-8 gap-4"

widget App {
    msg {
        Init,
        ClockTick,
        DoLogin,
        DoRegister,
        DoLogout,
        DismissSecret,
        SendMessage(str),
        RetrySend(str),
        Typing,
        SelectContact(str),
        OpenIdentity(str),
        SearchContacts(str),
        ProbeTrack
    }

    model {
        var booted bool = false
        var login_name str = ""
        var login_secret str = ""
    }

    // PLAN-056 T-02：主题设计默认（独立默认腿）。theme="Auto" 经 pac
    // `dep themes`（vendor/themes 固定快照）注册的官方树解析。本产品无
    // dark_mode 状态位/明暗切换（会话/凭据/消息业务不含外观状态），独立
    // 默认腿取静态 light 保现默认语义；桌面内宿主策略完整快照
    // （family+mode）按 031 full-host 语义整体接管（follow——pac theme 键
    // 保持缺省）。视图为语义 token 类（bg-card/text-foreground 等），族内
    // 明暗由 token 切换承接。Rust secure_hex 身份/凭据隔离业务原样。
    design {
        theme: "Auto"
        mode: "light"
    }

    timer {
        ClockTick (every_ms: 1000)
    }

    view {
        if .store.my_id == "" {
            // —— 登录屏：本端身份是会话归属的锚点 ——
            col {
                style: "w-full h-screen items-center justify-center bg-muted/20 p-6"
                col {
                    style: login_card
                    row {
                        style: "items-center gap-2"
                        text "💬" { style: "text-2xl" }
                        col {
                            text "Chat" { style: "text-xl font-bold text-foreground tracking-tight" }
                            text "真实人际聊天 · 凭据登录或注册新身份" { style: caption_text }
                        }
                    }
                    input {
                        placeholder: "你的名字（如：甲）"
                        value: .login_name
                        onenter: .DoLogin
                        style: "w-full px-4 py-2.5 bg-background border border-border rounded-xl text-sm text-foreground outline-none focus:border-primary transition-colors"
                    }
                    input {
                        placeholder: "恢复凭据 secret（注册新身份时留空）"
                        value: .login_secret
                        onenter: .DoLogin
                        style: "w-full px-4 py-2.5 bg-background border border-border rounded-xl text-sm text-foreground outline-none focus:border-primary transition-colors"
                    }
                    if .store.login_error != "" {
                        text .store.login_error { style: "text-xs text-destructive font-medium" }
                    }
                    button "登录" {
                        onclick: .DoLogin
                        style: "w-full px-5 py-2.5 bg-primary text-primary-foreground rounded-xl text-sm font-semibold shadow-xs hover:bg-primary/90 transition-colors"
                    }
                    button "注册新身份" {
                        onclick: .DoRegister
                        style: "w-full px-5 py-2 bg-card text-foreground rounded-xl text-sm font-medium border border-border hover:bg-accent transition-colors"
                    }
                    if .store.online == false {
                        text "连接断开：请确认后端已启动" { style: "text-xs text-muted-foreground" }
                    }
                }
            }
        }
        if .store.my_id != "" {
            // —— 会话壳 ——
            col {
                style: "w-full h-screen flex-col bg-muted/20 p-3 gap-3 overflow-hidden"
                // 注册一次性凭据横幅（CHAT-002）：secret 仅此一次展示，用户必须立即保存
                if .store.show_secret != "" {
                    col {
                        style: "px-5 py-4 bg-amber-50 dark:bg-amber-950 rounded-xl border-2 border-amber-400 gap-2"
                        text "🔑 请立即保存你的恢复凭据（secret）——仅显示这一次，退出后凭它重新登录" { style: "text-sm font-bold text-amber-900 dark:text-amber-100" }
                        text .store.show_secret { style: "text-sm font-mono text-amber-900 dark:text-amber-100 break-all select-text" }
                        button "我已保存，进入聊天" {
                            onclick: .DismissSecret
                            style: "self-start px-4 py-1.5 bg-amber-500 text-white rounded-lg text-xs font-semibold hover:bg-amber-600 transition-colors"
                        }
                    }
                }
                // Header：本端身份 + 连接状态
                row {
                    style: "items-center justify-between px-5 py-2.5 bg-card rounded-xl shadow-xs border border-border"
                    row {
                        style: "items-center gap-2"
                        text .store.my_avatar { style: "text-xl" }
                        col {
                            text .store.my_name { style: "text-sm font-bold text-foreground tracking-tight" }
                            if .store.online {
                                text "🟢 已连接" { style: "text-[10px] text-muted-foreground" }
                            } else {
                                text "🔴 连接断开，重试中…" { style: "text-[10px] text-destructive" }
                            }
                        }
                    }
                    row {
                        style: "items-center gap-3"
                        text "真实人际聊天" { style: "text-xs font-medium text-muted-foreground ml-2 px-2.5 py-0.5 bg-muted rounded-full border border-border/50" }
                        button "退出" {
                            onclick: .DoLogout
                            style: "px-3 py-1 bg-card text-muted-foreground rounded-lg text-xs font-medium border border-border hover:bg-accent hover:text-foreground transition-colors"
                        }
                    }
                }

                // Main Dual-column Body
                row {
                    style: main_shell
                    ChatSidebar(
                        contacts: .store.conv_list,
                        identities: .store.peer_list,
                        show_conv_list: .store.show_conv_list,
                        active_id: .store.active_contact_id,
                        my_id: .store.my_id,
                        search_query: .store.search_query,
                        on_select: .SelectContact,
                        on_open: .OpenIdentity,
                        on_search: .SearchContacts
                    )
                    col {
                        style: main_shell
                        MessageThread(
                            messages: .store.messages,
                            pending: .store.pending,
                            typing_name: .store.typing_name,
                            peer_name: .store.active_peer_name,
                            peer_avatar: .store.active_peer_avatar,
                            peer_status: .store.active_peer_status,
                            my_id: .store.my_id,
                            on_retry: .RetrySend
                        )
                        if .store.send_nonce != "" {
                            Composer(on_send: .SendMessage, on_typing: .Typing)
                        } else {
                            text .store.login_error { style: "text-sm text-destructive p-3" }
                        }
                    }
                }
            }
        }
    }

    on {
        .Init -> {
            if .booted == false {
                .booted = true
            }
            .ProbeTrack()
        }
        .ProbeTrack -> {
            store.show_conv_list = Env.track() == "vue"
        }
        .ClockTick -> {
            store.RefreshTick()
        }
        .DoLogin -> {
            store.login_secret = .login_secret
            store.Login(.login_name)
        }
        .DoRegister -> {
            store.Register(.login_name)
        }
        .DoLogout -> {
            store.Logout()
        }
        .DismissSecret -> {
            store.DismissSecret()
        }
        .SendMessage(text) -> {
            store.SendText(text)
        }
        .RetrySend(cid) -> {
            store.RetrySend(cid)
        }
        .Typing -> {
            store.MarkTyping()
        }
        .SelectContact(id) -> {
            store.SelectContact(id)
        }
        .OpenIdentity(peer_id) -> {
            store.OpenIdentity(peer_id)
        }
        .SearchContacts(query) -> {
            store.Search(query)
        }
    }
}
